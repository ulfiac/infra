{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges"
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "groupName": "Monday packages",
      "matchPackageNames": [
        "actions/checkout",
        "hashicorp/archive",
        "hashicorp/aws",
        "aws-actions/configure-aws-credentials",
        "integrations/github",
        "gruntwork-io/terragrunt-action",
        "hashicorp/setup-terraform",
        "hashicorp/terraform",
        "hashicorp/local",
        "hashicorp/random"
      ],
      "minimumReleaseAge": "7 days",
      "reviewers": [
        "ulfiac"
      ],
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "automerge": true,
      "groupName": "commons packages",
      "matchPackageNames": [
        "ulfiac/commons"
      ]
    },
    {
      "automerge": true,
      "groupName": "container packages",
      "matchPackageNames": [
        "ghcr.io/ulfiac/terragrunt-runner"
      ]
    }
  ],
  "prHourlyLimit": 5,
  "timezone": "America/New_York"
}
