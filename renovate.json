{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned ghcr.io/ulfiac images in Terraform (e.g. the eks_runner module's image variable default), which the terraform manager doesn't detect",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/^terraform/.+\\.tf$/"
      ],
      "matchStrings": [
        "\"(?<depName>ghcr\\.io/ulfiac/[^:\"\\s]+):(?<currentValue>[^@\"\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    },
    {
      "customType": "regex",
      "description": "GitHub-hosted runner label assigned to a shell variable in workflow run scripts",
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "github_runner='(?<depName>ubuntu|macos|windows)-(?<currentValue>[^'\\s]+)'"
      ]
    },
    {
      "customType": "regex",
      "description": "Pinned ghcr.io/ulfiac images assigned to shell variables in workflow run scripts",
      "datasourceTemplate": "docker",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "'(?<depName>ghcr\\.io/ulfiac/[^:'\\s]+):(?<currentValue>[^@'\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ]
    }
  ],
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    "mergeConfidence:all-badges"
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "groupName": "Monday packages",
      "groupSingleUpdates": true,
      "matchPackageNames": [
        "actions/checkout",
        "hashicorp/archive",
        "hashicorp/aws",
        "aws-actions/configure-aws-credentials",
        "integrations/github",
        "gruntwork-io/terragrunt-action",
        "hashicorp/setup-terraform",
        "hashicorp/terraform",
        "hashicorp/local",
        "hashicorp/random"
      ],
      "minimumReleaseAge": "7 days",
      "reviewers": [
        "ulfiac"
      ],
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "automerge": true,
      "groupName": "commons packages",
      "groupSingleUpdates": true,
      "matchPackageNames": [
        "ulfiac/commons"
      ]
    },
    {
      "automerge": true,
      "groupName": "containers packages",
      "groupSingleUpdates": true,
      "matchPackageNames": [
        "ghcr.io/ulfiac/terra-runner",
        "ghcr.io/ulfiac/terragrunt-runner"
      ]
    }
  ],
  "prHourlyLimit": 5,
  "timezone": "America/New_York"
}
